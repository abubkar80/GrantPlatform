TableGroup Identity {
  users
  student_profiles
  donor_profiles
}
TableGroup Reference_data {
  institutions
  programmes
  local_governments
  academic_periods
}
TableGroup Spatie_permissions {
  roles
  permissions
  model_has_roles
  model_has_permissions
  role_has_permissions
}
TableGroup Applications {
  applications
  application_drafts
  application_versions
  application_reviews
  case_assignments
}
TableGroup Scoring {
  scoring_policies
  need_assessments
}
TableGroup Funds_and_rules {
  funds
  fund_rule_versions
  rule_institutions
  rule_programmes
  rule_levels
  rule_origin_lgas
  rule_categories
}
TableGroup Academics {
  academic_records
  academic_versions
  benchmark_evaluations
  academic_flags
